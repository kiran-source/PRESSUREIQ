# Set default behavior to automatically normalize line endings to LF on commit
* text=auto eol=lf

# Source code and scripts
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Documentation and configuration
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.csv text eol=lf
*.html text eol=lf

# Canonical frozen competition deliverables (preserve exact CRLF byte sequence across all platforms)
data/processed/final_batter_rankings.csv text eol=crlf
data/processed/final_bowler_rankings.csv text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files (do not touch line endings)
*.parquet binary
*.pdf binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
